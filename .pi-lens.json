{
  "$schema": "https://raw.githubusercontent.com/apmantza/pi-lens/master/docs/schema/pi-lens-config-v1.json",
  "ignore": [
    "vendor/",
    "node_modules/",
    "public/build/",
    "public/js/filament/",
    "public/css/filament/",
    "public/fonts/filament/",
    "public/js/malzariey/",
    "public/css/malzariey/",
    "public/css/app/",
    "public/js/webpush.js",
    "public/sw.js"
  ],
  "lsp": {
    "disabledServers": [
      "typescript",
      "deno",
      "opengrep",
      "ast-grep",
      "typos"
    ]
  },
  "rules": {
    "js-vendor-noise": {
      "disable": [
        "no-unused-vars",
        "no-unused-expressions",
        "unchecked-throwing-call",
        "unchecked-throwing-call-js",
        "throw-error-instead-of-string",
        "throw-error-object",
        "throw-error-object-js",
        "tuples-invalid-index"
      ]
    }
  }
}
